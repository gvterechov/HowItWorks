<%= render partial: 'expressions/common/header' %>

<div class="ui stackable grid">
  <div class="eight wide column">
    <h3 class="ui header"><%= t('available_tasks', default: 'Доступные задачи') %></h3>

    <%= form_with url: edit_tag_path(locale: I18n.locale, id: @task_tag.id, taggable_type: @taggable_type), method: :get, local: true, class: 'ui form' do %>
      <%= hidden_field_tag :tag_name, @task_tag.name %>

      <% @selected_task_ids.each do |id| %>
        <%= hidden_field_tag 'selected_task_ids[]', id %>
      <% end %>

      <table class="ui compact celled selectable striped table">
        <thead>
          <tr>
            <th>ID</th>
            <th><%= t('tasks.name', default: 'Название') %></th>
            <th class="center aligned"><%= t('actions', default: 'Действия') %></th>
          </tr>
        </thead>
        <tbody>
          <% @tasks.each do |task| %>
            <% included = @selected_task_ids.include?(task.id.to_s) %>
            <tr>
              <td><%= task.id %></td>
              <td><%= task.title %></td>
              <td class="center aligned">
                <% if included %>
                  <div class="ui mini buttons">
                    <button class="ui green disabled button" type="button">
                      <i class="plus icon"></i> <%= t('add', default: 'Добавить') %>
                    </button>
                    <button class="ui red button" type="submit" name="remove_task_id" value="<%= task.id %>">
                      <i class="minus icon"></i> <%= t('remove', default: 'Убрать') %>
                    </button>
                  </div>
                <% else %>
                  <div class="ui mini buttons">
                    <button class="ui green button" type="submit" name="add_task_id" value="<%= task.id %>">
                      <i class="plus icon"></i> <%= t('add', default: 'Добавить') %>
                    </button>
                    <button class="ui red disabled button" type="button">
                      <i class="minus icon"></i> <%= t('remove', default: 'Убрать') %>
                    </button>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <div class="eight wide column">
    <h3 class="ui header"><%= t('tags.edit_tag', default: 'Редактирование тега') %></h3>

    <%= form_with url: tag_path(locale: I18n.locale, id: @task_tag.id), method: :patch, local: true, class: 'ui form' do %>
      <div class="field">
        <label><%= t('tags.tags_name', default: 'Название тега') %></label>
        <%= text_field_tag :tag_name, @task_tag.name, required: true %>
      </div>

      <%= hidden_field_tag :taggable_type, @taggable_type %>

      <% @selected_task_ids.each do |task_id| %>
        <%= hidden_field_tag 'selected_ids[]', task_id %>
      <% end %>

      <%= submit_tag t('save', default: 'Сохранить'), class: "ui primary button" %>
    <% end %>
  </div>
</div>
