<%= render partial: 'expressions/common/header' %>

<div class="ui stackable grid">
  <div class="eight wide column">
    <h3 class="ui header"><%= t("available_tasks", default: 'Доступные объекты') %></h3>

    <% selected_ids = (@selected_ids || []).map(&:to_s) %>

    <table class="ui compact celled selectable striped table">
      <thead>
        <tr>
          <th>ID</th>
          <th><%= t("tasks.name", default: 'Название') %></th>
          <th class="center aligned"><%= t('actions', default: 'Действия') %></th>
        </tr>
      </thead>
      <tbody>
        <% @items.each do |item| %>
          <% item_id_str = item.id.to_s %>
          <% included = selected_ids.include?(item_id_str) %>
          <tr>
            <td><%= item.id %></td>
            <td><%= item.try(:title) || item.try(:name) || item.to_s %></td>
            <td class="center aligned">
              <% if included %>
                <%= hidden_field_tag 'selected_ids[]', item.id %>
                <div class="ui mini buttons">
                  <button class="ui green disabled button" type="button">
                    <i class="plus icon"></i> <%= t('add', default: 'Добавить') %>
                  </button>

                  <%= link_to t('remove', default: 'Убрать'),
                    new_tag_path(locale: I18n.locale,
                                 taggable_type: @taggable_type,
                                 tag_name: @task_tag.name,
                                 selected_ids: selected_ids.reject { |id| id == item_id_str }),
                    method: :get,
                    class: 'ui red button' %>
                </div>
              <% else %>
                <div class="ui mini buttons">
                  <%= link_to t('add', default: 'Добавить'),
                    new_tag_path(locale: I18n.locale,
                                 taggable_type: @taggable_type,
                                 tag_name: @task_tag.name,
                                 selected_ids: selected_ids + [item_id_str]),
                    method: :get,
                    class: 'ui green button' %>

                  <button class="ui red disabled button" type="button">
                    <i class="minus icon"></i> <%= t('remove', default: 'Убрать') %>
                  </button>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="eight wide column">
    <h3 class="ui header"><%= t('create_tag') %></h3>

    <%= form_with url: tags_path(locale: I18n.locale, taggable_type: @taggable_type), method: :post, local: true, class: 'ui form' do |f| %>
      <% selected_ids.each do |id| %>
        <%= hidden_field_tag 'selected_ids[]', id %>
      <% end %>

      <div class="field">
        <%= f.label :tag_name, t('tags_name') %>
        <%= f.text_field :tag_name, value: @task_tag.name, required: true, placeholder: t('enter_tag_name', default: 'Введите имя тега') %>
      </div>

      <div class="field" style="margin-top: 1em;">
        <%= f.submit t('save'), class: 'ui primary button' %>
      </div>
    <% end %>
  </div>
</div>
