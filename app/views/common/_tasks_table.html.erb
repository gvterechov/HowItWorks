<%
  enable_hints ||= false
%>
<div class="ui aligned basic segment">
  <div class="ui centered grid">

    <!-- Заголовок и кнопки -->
    <div class="row">
      <div class="center aligned sixteen wide column">
        <h3><%= t('my_tasks') %></h3>
        <div class="ui buttons">
          <%= link_to "<i class='plus icon'></i>#{t('new')}".html_safe,
                      new_task_path,
                      class: 'ui primary button' %>

          <%= link_to "<i class='plus icon'></i>#{t('new_tag')}".html_safe,
              new_task_tag,
              class: 'ui button teal',
              style: 'margin-left: 0.5em;' %>
        </div>
      </div>
    </div>

    <!-- Фильтр -->
    <div class="row">
      <div class="sixteen wide column">
        <h4 class="ui dividing header"><%= t('filter_by_tags') %></h4>
        <%= form_with url: request.path, method: :get, local: true, class: 'ui form' do %>
          <div class="inline fields">
            <% @all_tags.each do |tag| %>
              <div class="field">
                <div class="ui checkbox">
                  <%= check_box_tag "filter_tag_ids[]", tag.id, @selected_tag_ids.include?(tag.id), id: "tag_#{tag.id}", onchange: "this.form.submit();" %>
                  <%= label_tag "tag_#{tag.id}", tag.name %>
                </div>
              </div>
            <% end %>
            <div class="field">
              <%= link_to t('reset'), request.path, class: "ui basic button" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Таблица -->
    <div class="row">
      <div class="sixteen wide column">
        <table class="ui selectable striped table">
          <!-- table content -->
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    $('.ui.checkbox').checkbox();
  });
</script>
    
    <div class="row">
      <table class="ui selectable striped table">
        <thead>
        <tr>
          <th>#</th>
          <th><%= t('tasks.created_at') %></th>
          <th><%= t('tasks.name') %></th>
          <th><%= t('tasks.started_attempts_count') %></th>
          <th><%= t('tasks.done_attempts_count') %></th>
          <th><%= t('collect_statistics') %></th>
          <% if enable_hints %>
            <th><%= t('enable_hints') %></th>
          <% end %>
        </tr>
        </thead>
        <tbody>
        <% tasks.each_with_index do |task, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= full_date(task.created_at) %></td>
            <td>
              <%= link_to task_name(task),
                          "#{show_task_path}/#{task.token}",
                          target: '_blank'
              %>
            </td>
            <td>
              <% if task.attempts.count > 0 %>
                <%= link_to task.attempts.count,
                            "#{show_task_path}/#{task.token}/statistic",
                            target: '_blank',
                            'data-tooltip': t('tasks.show_statistic')
                %>
              <% else %>
                0
              <% end %>
            </td>
            <td><%= task.attempts.was_done.count %></td>
            <td><%= book_icon(task.introduce_yourself?) %></td>
            <% if enable_hints %>
              <td>
                <%= book_icon(task.enable_hints?) %>
                <% if task.enable_hints? %>
                  (<%= task.max_hints_count %>)
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
        </tbody>
      </table>

    </div>
  </div>
</div>
