<div class="ui aligned basic segment">
  <div class="ui centered grid">
    <h3>
      <%= t('my_tags', default: 'Мои теги') %>
      <%= link_to "<i class='plus icon'></i>#{t('new_tag', default: 'Новый тег')}".html_safe,
                  new_task_tag_path,
                  class: 'ui basic button' %>
    </h3>

    <div class="row">
      <table class="ui selectable striped celled table">
        <thead>
          <tr>
            <th>#</th>
            <th>ID</th>
            <th><%= t('tags.name', default: 'Имя тега') %></th>
            <th class="center aligned"><%= t('actions', default: 'Действия') %></th>
          </tr>
        </thead>
        <tbody>
          <% @tags.each_with_index do |tag, index| %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= tag.id %></td>
              <td><%= tag.name %></td>
              <td class="center aligned">
                <div class="ui buttons">
                  <%= link_to tag(tag), class: 'ui tiny basic primary button' do %>
                    <i class="edit icon"></i> <%= t('edit', default: 'Редактировать') %>
                  <% end %>

                <%= button_to expressions_destroy_tag_path(id: tag.id),
                    method: :delete,
                    data: { confirm: 'Вы уверены, что хотите удалить тег?' },
                    class: 'ui red basic button' do %>
                <i class="trash icon"></i>
                    Удалить
                <% end %>


                             </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>