<%
  enable_hints ||= false
%>
<table class="ui selectable striped table">
  <thead>
    <tr>
      <th>ID</th>
      <th><%= t('tasks.name') %></th>
      <th>Действия</th>
    </tr>
  </thead>
  <tbody>
    <% tasks.each do |task| %>
      <tr>
        <td><%= task.id %></td>
        <td><%= task.title %></td>
        <td>
          <button class="ui mini green button add-task" data-task-id="<%= task.id %>">
            <i class="plus icon"></i> Добавить
          </button>
          <button class="ui mini red button remove-task" data-task-id="<%= task.id %>">
            <i class="minus icon"></i> Убрать
          </button>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
