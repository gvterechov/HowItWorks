<% title t('expressions.index.title') %>

<%= render partial: 'expressions/common/header' %>

<div class="ui grid">
  <!-- Левая колонка: Таблица -->
  <div class="eight wide column">
    <%= render partial: 'common/tasks_short_table', locals: { tasks: @tasks } %>
  </div>

  <!-- Правая колонка: Форма -->
  <div class="eight wide column">
    <div class="ui form">
      <div class="field">
        <label>Название tag</label>
        <input type="text" name="task_name" placeholder="Введите название...">
      </div>
      <button class="ui primary button">
        <i class="save icon"></i>
        Сохранить
      </button>
    </div>
  </div>
</div>

<%#= render partial: 'common/footer' %>
